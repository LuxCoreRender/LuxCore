# Generate the sources embedding the pre-compiled SPIR-V modules: one source
# file per module (the SPIR-V binary in hexadecimal format) and
# embeddedspirv.cpp with the registry mapping the kernel cache hash to the
# modules.

if(NOT DEFINED INPUT_DIR OR NOT DEFINED OUTPUT_DIR)
  message(FATAL_ERROR "Usage: cmake -DINPUT_DIR=... -DOUTPUT_DIR=... -P GenerateEmbeddedSPIRV.cmake")
endif()

set(MAX_STRING_LITERAL_SIZE 60000)

file(STRINGS ${INPUT_DIR}/spirvmanifest.txt SPIRV_MANIFEST)

set(SPIRV_REGISTRY_DECLARATIONS "")
set(SPIRV_REGISTRY_ENTRIES "")

foreach(SPIRV_MANIFEST_LINE ${SPIRV_MANIFEST})
  separate_arguments(SPIRV_MANIFEST_FIELDS UNIX_COMMAND "${SPIRV_MANIFEST_LINE}")
  list(GET SPIRV_MANIFEST_FIELDS 0 SPIRV_MODULE_NAME)
  list(GET SPIRV_MANIFEST_FIELDS 1 SPIRV_MODULE_HASH)

  # Read the SPIR-V module in hexadecimal format
  file(READ ${INPUT_DIR}/${SPIRV_MODULE_NAME}.spv SPIRV_MODULE_HEX HEX)

  # Write the module source file
  set(SPIRV_MODULE_FILE ${OUTPUT_DIR}/${SPIRV_MODULE_NAME}_module.cpp)
  file(WRITE ${SPIRV_MODULE_FILE} "// Generated by GenerateEmbeddedSPIRV.cmake -- do not edit\n\n")
  file(APPEND ${SPIRV_MODULE_FILE} "#include <cstddef>\n#include <string>\n\n")
  file(APPEND ${SPIRV_MODULE_FILE} "namespace luxrays { namespace spirvregistry {\n\n")
  file(APPEND ${SPIRV_MODULE_FILE} "const std::string &Get_${SPIRV_MODULE_NAME}() {\n")
  file(APPEND ${SPIRV_MODULE_FILE} "\tstatic const std::string module =\n")

  # Split the string in chunks: there is a limit on the size of a string
  # literal (i.e. 65535 characters for MSVC)
  string(LENGTH "${SPIRV_MODULE_HEX}" SPIRV_MODULE_HEX_SIZE)
  set(SPIRV_MODULE_HEX_POS 0)
  while(SPIRV_MODULE_HEX_POS LESS SPIRV_MODULE_HEX_SIZE)
    string(SUBSTRING "${SPIRV_MODULE_HEX}" ${SPIRV_MODULE_HEX_POS} ${MAX_STRING_LITERAL_SIZE} SPIRV_MODULE_HEX_CHUNK)
    file(APPEND ${SPIRV_MODULE_FILE} "\t\t\"${SPIRV_MODULE_HEX_CHUNK}\"\n")
    math(EXPR SPIRV_MODULE_HEX_POS "${SPIRV_MODULE_HEX_POS} + ${MAX_STRING_LITERAL_SIZE}")
  endwhile()
  file(APPEND ${SPIRV_MODULE_FILE} "\t\t;\n\n\treturn module;\n}\n\n}\n}\n")

  # Add the module to the registry
  set(SPIRV_REGISTRY_DECLARATIONS "${SPIRV_REGISTRY_DECLARATIONS}const std::string &Get_${SPIRV_MODULE_NAME}();\n")
  set(SPIRV_REGISTRY_ENTRIES "${SPIRV_REGISTRY_ENTRIES}\t\t{ \"${SPIRV_MODULE_HASH}\", &spirvregistry::Get_${SPIRV_MODULE_NAME} },\n")
endforeach()

# Write the registry source file
file(WRITE ${OUTPUT_DIR}/embeddedspirv.cpp "// Generated by GenerateEmbeddedSPIRV.cmake -- do not edit\n\n")
file(APPEND ${OUTPUT_DIR}/embeddedspirv.cpp [[#include <cstddef>
#include <memory>
#include <mutex>
#include <string>
#include <unordered_map>

#include "luxrays/utils/embeddedspirv.h"

namespace luxrays {

namespace spirvregistry {
]])
file(APPEND ${OUTPUT_DIR}/embeddedspirv.cpp "\n${SPIRV_REGISTRY_DECLARATIONS}\n}\n\n")
file(APPEND ${OUTPUT_DIR}/embeddedspirv.cpp [[namespace {

typedef const std::string & (*SPIRVModuleGetter)();

std::string HexDecode(const std::string &hex) {
	std::string decoded(hex.size() / 2, '\0');
	for (std::size_t i = 0; i < decoded.size(); ++i) {
		const int high = (hex[2 * i] <= '9') ? (hex[2 * i] - '0') : (hex[2 * i] - 'a' + 10);
		const int low = (hex[2 * i + 1] <= '9') ? (hex[2 * i + 1] - '0') : (hex[2 * i + 1] - 'a' + 10);
		decoded[i] = static_cast<char>(high * 16 + low);
	}
	return decoded;
}

const std::unordered_map<std::string, SPIRVModuleGetter> &GetRegistry() {
	static const std::unordered_map<std::string, SPIRVModuleGetter> registry = {
]])
file(APPEND ${OUTPUT_DIR}/embeddedspirv.cpp "${SPIRV_REGISTRY_ENTRIES}")
file(APPEND ${OUTPUT_DIR}/embeddedspirv.cpp [[	};
	return registry;
}

}

const unsigned char *GetEmbeddedSPIRVModule(const std::string &hash, std::size_t *size) {
	static std::mutex moduleMutex;
	static std::unordered_map<std::string, std::unique_ptr<std::string>> modules;

	const auto &registry = GetRegistry();
	const auto it = registry.find(hash);
	if (it == registry.end()) {
		if (size)
			*size = 0;
		return nullptr;
	}

	// Decode the module only once
	std::lock_guard<std::mutex> lock(moduleMutex);

	std::unique_ptr<std::string> &module = modules[hash];
	if (!module)
		module = std::make_unique<std::string>(HexDecode(it->second()));

	if (size)
		*size = module->size();
	return reinterpret_cast<const unsigned char *>(module->data());
}

}
]])
