scene.camera.type = "perspective"
scene.camera.lookat.orig = 0.30 0.15 0.30
scene.camera.lookat.target = 0.0 0.1 0.0
scene.camera.fieldofview = 45
#################################################################################
scene.textures.wireframetex.type = wireframe
# Thinner than the Lucy and dragon scenes: the bunny mesh is a few
# times smaller and its triangles bigger in world units, so the 0.002
# border of the others would cover most of the surface
scene.textures.wireframetex.width = 0.0005
scene.textures.wireframetex.border = 1.0 0.0 0.0
scene.textures.wireframetex.inside = 1.0 1.0 1.0
#################################################################################
scene.materials.mat_white.type = matte
scene.materials.mat_white.kd = wireframetex
#################################################################################
scene.shapes.obj_bunnyply.type = mesh
scene.shapes.obj_bunnyply.ply = scenes/displacement/bunny/bunny.ply
##
scene.shapes.obj_bunnysimplify.type = simplify
scene.shapes.obj_bunnysimplify.source = obj_bunnyply
scene.shapes.obj_bunnysimplify.target = 0.1
scene.shapes.obj_bunnysimplify.preserveborder = 1
##
scene.shapes.obj_bunny.type = harlequin
scene.shapes.obj_bunny.source = obj_bunnysimplify
#################################################################################
scene.objects.obj_bunny.ply = obj_bunny
scene.objects.obj_bunny.material = mat_white
# The bunny stands along raw +y in the source mesh (the ears at the
# max y end, height 0.154, width 0.156 along raw x, depth 0.121 along
# raw z, bbox center (-0.017, 0.110, -0.001)), facing raw +x (the
# nose at raw (0.030, 0.122), the haunches and tail at the min x
# side). LuxCore's default camera up is (0, 0, 1), so the first
# rotation maps raw +y to the scene z axis (the bunny stands upright)
# and the 45 degree rotation about the scene z axis turns her face
# from the scene +x to the (+x, +y) diagonal, toward the camera
# quadrant. The mesh is already at the scene scale (0.15 units, like
# the dragon and Lucy scenes), so the scale stays identity and the
# translation row pivots the bbox center at (0, 0.1, 0). The written
# form is the transpose - LuxCore applies it as a row vector times
# matrix
scene.objects.obj_bunny.transformation = 0.7071068 0.7071068 0 0  0 0 1 0  0.7071068 -0.7071068 0 0  0.012940 0.110819 -0.110200 1
#################################################################################
scene.lights.infinitelight.type = infinite
scene.lights.infinitelight.file = scenes/simple-mat/sky.exr
scene.lights.infinitelight.gamma = 1.0
scene.lights.infinitelight.gain = 1.0 1.0 1.0
scene.lights.infinitelight.storage = byte
