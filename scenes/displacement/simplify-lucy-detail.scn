# A side by side comparison of the simplification on the Stanford
# Lucy statue: the unsimplified reference on the left (plain white,
# 28,055,742 faces), the simplified instance on the right (white
# facets with red wireframe hairlines, target 0.0015 -> 38,356 faces).
# The dark backdrop behind the pair keeps the white figures readable
# (the sky of the infinite light is light gray). The reference and
# the camera values are measured: the pair is centered within 21 px
# and both figures fit the frame with a 114 px gap
scene.camera.type = "perspective"
scene.camera.lookat.orig = 0.2528 0.0852 0.2498
scene.camera.lookat.target = 0.0 0.045 0.015
scene.camera.fieldofview = 45
#################################################################################
scene.textures.wireframetex.type = wireframe
# Hairline borders: the width is in world units, and at 38,356 faces
# the triangles are about 1.2mm in scene units - the 0.002 of the
# benchmark scenes would cover the whole surface
scene.textures.wireframetex.width = 0.0001
scene.textures.wireframetex.border = 1.0 0.0 0.0
scene.textures.wireframetex.inside = 1.0 1.0 1.0
#################################################################################
scene.materials.mat_white.type = matte
scene.materials.mat_white.kd = wireframetex
#################################################################################
scene.materials.mat_plain.type = matte
scene.materials.mat_plain.kd = 1.0 1.0 1.0
# The dark backdrop behind the pair: the white figures are unreadable
# against the light gray sky
scene.materials.mat_backdrop.type = matte
scene.materials.mat_backdrop.kd = 0.25 0.25 0.25
#################################################################################
scene.shapes.obj_lucyply.type = mesh
scene.shapes.obj_lucyply.ply = scenes/displacement/lucy/lucy.ply
##
scene.shapes.obj_lucysimplify.type = simplify
scene.shapes.obj_lucysimplify.source = obj_lucyply
scene.shapes.obj_lucysimplify.target = 0.0015
scene.shapes.obj_lucysimplify.preserveborder = 1
##
scene.shapes.obj_lucy.type = harlequin
scene.shapes.obj_lucy.source = obj_lucysimplify
#################################################################################
scene.objects.obj_lucy.ply = obj_lucy
scene.objects.obj_lucy.material = mat_white
# The unsimplified reference beside her (the left figure of the pair):
# the same placement, translated 0.11 along the scene y axis, and a
# plain white matte - the wireframe of 28M sub pixel triangles would
# read as one solid red silhouette, the reference must stay smooth
scene.objects.obj_lucyref.ply = obj_lucyply
scene.objects.obj_lucyref.material = mat_plain
scene.objects.obj_lucyref.transformation = 0.00007071068 -0.00007071068 0 0  0.00007071068 0.00007071068 0 0  0 0 0.0001 0  -0.04025022 0.04743736 -0.01926266 1
# The statue stands along +z in the raw mesh (millimeter scale, bbox
# center (690.76, -121.53, 192.63), wings spread along raw +x, head at
# the +z end). LuxCore's default camera up is (0, 0, 1), so the
# identity rotation keeps her standing upright with her head at the top
# of the frame, and the rotation of -pi/4 around the scene z axis (her
# vertical) turns her on the spot: her raw +x (the wings) maps to the
# (+x, -y) diagonal, away from the camera quadrant. The 1e-4 scale
# brings her to scene scale and the translation row pivots the bbox
# center at (0, 0.1, 0). The written form is the transpose - LuxCore
# applies it as a row vector times matrix
scene.objects.obj_lucy.transformation = 0.00007071068 -0.00007071068 0 0  0.00007071068 0.00007071068 0 0  0 0 0.0001 0  -0.04025022 0.15743736 -0.01926266 1
#################################################################################
# The backdrop: the 60x60 quad of large-plane.ply (normal +z), rotated
# so its normal points at the camera and parked 0.45 behind the pair -
# it fills the frame behind the figures while the infinite light keeps
# lighting them unchanged
scene.shapes.obj_backdropply.type = mesh
scene.shapes.obj_backdropply.ply = scenes/displacement/large-plane.ply
scene.objects.obj_backdrop.ply = obj_backdropply
scene.objects.obj_backdrop.material = mat_backdrop
scene.objects.obj_backdrop.transformation = -0.2114825 0.9773818 0 0  -0.6569424 -0.1421470 0.7404194 0  0.7236724 0.1565858 0.6721451 0  -0.3256526 -0.0399636 -0.2874653 1
#################################################################################
scene.lights.infinitelight.type = infinite
scene.lights.infinitelight.file = scenes/simple-mat/sky.exr
scene.lights.infinitelight.gamma = 1.0
scene.lights.infinitelight.gain = 1.0 1.0 1.0
scene.lights.infinitelight.storage = byte
