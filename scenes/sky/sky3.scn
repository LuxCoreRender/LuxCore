scene.camera.lookat.orig = 8.51502 -6.443411 1.72403
scene.camera.lookat.target = 1.199165 0.311952 0.805705
scene.camera.fieldofview = 56.145
################################################################################
scene.materials.Matte.type = matte
scene.materials.Matte.kd = 0.40197 0.40197 0.40197
scene.materials.Mirror.type = mirror
scene.materials.Mirror.kr = 1. 1. 1.
################################################################################
scene.objects.Matte.material = Matte
scene.objects.Matte.ply = scenes/sky/Matte.ply
scene.objects.Mirror.material = Mirror
scene.objects.Mirror.ply = scenes/sky/Mirror.ply
################################################################################
# Test of the Prague Sky Model (Wilkie 2021) based sun3 light source alone
# (the sky3 light below is disabled). The background is black because there
# is no environment light: only the direct sun illumination is rendered.
scene.lights.sunlight3.type = sun3
scene.lights.sunlight3.dir = 0.166974 -0.59908 0.783085
# Full dataset of the Prague Sky Model (2.2 GB), downloaded from
# https://github.com/PetrVevoda/pragueskymodel ("Full version")
scene.lights.sunlight3.dataset = scenes/sky/SkyModelDataset.dat
# Horizontal visibility in km ([20, 131.8] for the full dataset)
scene.lights.sunlight3.visibility = 59.4
# Observer altitude in m ([0, 15000] for the full dataset)
scene.lights.sunlight3.altitude = 0.0
scene.lights.sunlight3.groundalbedo = 0.0
scene.lights.sunlight3.gain = 1 1 1
# 1.0 is the angular size of the real sun disc; use a larger value to make
# the disc easier to see in a quick test
scene.lights.sunlight3.relsize = 1.0
#scene.lights.sunlight3.relsize = 32.0

